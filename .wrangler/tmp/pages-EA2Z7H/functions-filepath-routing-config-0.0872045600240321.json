    {
      "routePath": "/api/game/save",
      "mountPath": "/api/game",
      "method": "",
      "module": [
        "api/game/save.ts:onRequest"
      ]
    },
    {
      "routePath": "/api/game/:id",
      "mountPath": "/api/game",
      "method": "",
