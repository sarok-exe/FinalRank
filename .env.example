# Firebase (public client keys — safe to commit placeholders, fill with your own)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Supabase (publishable anon key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Turso — SERVER-SIDE ONLY. Never prefix these with VITE_ or they get
# inlined into the public client bundle. Used by Cloudflare Pages Functions
# (set as dashboard secrets) and scripts/sync-puzzles.mjs.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=